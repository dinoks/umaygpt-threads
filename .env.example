# Threads API (получено через Генератор маркеров пользователя)
THREADS_USER_ID=
THREADS_ACCESS_TOKEN=

# Gemini API (aistudio.google.com -> Get API key)
GEMINI_API_KEY=
GEMINI_IMAGE_MODEL=gemini-2.5-flash-image  # или gemini-3-pro-image-preview

# Claude API (для draft_from_voice.py, опционально)
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Для локального теста (на проде ставится автоматически в GH Actions)
REPO_RAW_BASE=https://raw.githubusercontent.com/USERNAME/umaygpt-threads/main
